# ─────────────────────────────────────────────────────────────────────────────
# SRAMS Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local (development) or .env.production (production)
# Generate secrets using: npx tsx scripts/generate-secrets.ts
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────────────────
# Base URL for the application (used for email links, redirects, etc.)
APP_BASE_URL=http://localhost:3000

# Node environment: development | production
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Development: Use localhost with exposed port
# Production: Use Docker internal network (srams_db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=722811
POSTGRES_DB=SRAMS_DB
DATABASE_URL=postgresql://postgres:722811@localhost:5432/SRAMS_DB

# ─── Authentication ──────────────────────────────────────────────────────────
# JWT signing key (minimum 32 bytes, base64 encoded)
# Generate with: npx tsx scripts/generate-secrets.ts
AUTH_SECRET=generate-me-with-scripts-generate-secrets

# ─── Session Security ────────────────────────────────────────────────────────
# Set to "true" when HTTPS is active (required for production)
# Set to "false" only for local HTTP development or LAN testing without HTTPS
SESSION_COOKIE_SECURE=true

# Number of trusted reverse proxies in front of the app
# Cloudflare (1) + NPM/Nginx (1) = 2
# Used for accurate IP address extraction from X-Forwarded-For header
TRUSTED_PROXY_COUNT=2

# ─── Cron Jobs ───────────────────────────────────────────────────────────────
# Secret for authenticating cron endpoint requests
# Generate with: npx tsx scripts/generate-secrets.ts
# Usage: curl -X DELETE -H "Authorization: Bearer $CRON_SECRET" /api/cron/...
# Leave empty to disable cron endpoints (returns 503)
CRON_SECRET="e7d2c4c3973075e40fc0d96ce79f300176bc7c3256adb573978b9123c4c3e9e5"

# ─── Email (Gmail SMTP) ──────────────────────────────────────────────────────
# For sending invoices and notifications
# Leave blank to disable email features
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=europhilsolutions@gmail.com
GMAIL_APP_PASSWORD=ykdpehzpfyekvkvj

# ─── Stripe (Payment Processing) ─────────────────────────────────────────────
# For online payment processing (optional)
# Leave blank to disable Stripe integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Redis (Optional) ────────────────────────────────────────────────────────
# For distributed rate limiting (only needed for multi-instance deployment)
# Leave blank to use in-memory rate limiting
REDIS_URL=
