# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.


# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.playwright-mcp*
.gstack*
/e2e/.state/
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build
postgres_data/
.postgres_data/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets - never commit)
.env*
!.env.example
.env.local
.env.production
.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# docs (ignore generated/temporary, keep tracked docs)
.gstack/
# Ignore docs that match these patterns, EXCEPT the negations below
docs/TANSTACK-MIGRATION/
docs/TANSTACK-FORM*.md
docs/PROJECT*.md

# Database dumps and backups (SECURITY: prevent accidental commits)
*.sql
*backup*.sql
*.dump
*.bak
!drizzle/*.sql

# Student photo uploads (keep .gitkeep only)
public/uploads/students/*
!public/uploads/students/.gitkeep

# Agent skill packages (installed via `npx skills add`). Not app code - and
# Tailwind v4 auto-source-detection would otherwise scan their markdown,
# compiling the very example classes the design guideline bans.
.agents/
skills-lock.json
